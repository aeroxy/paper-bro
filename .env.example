# paper-bro configuration. Copy to .env for local runs, and set the same
# variables wherever you deploy.

# --- Credentials (required) ---
# Neon Postgres. Pooled or direct both work; migrations run at boot.
NEON_DB=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Baseten Model APIs key (see BASETEN.md).
BASETEN_API_KEY=
# AERO personal access token, minted at https://aero.oops.wtf/connect. It
# expires after at most 90 days; publishing fails with a clear error after that.
AERO_TOKEN=

# --- Model ---
BASETEN_MODEL=meta-models/muse-spark-open
# Used automatically if BASETEN_MODEL stops existing (HTTP 404).
BASETEN_FALLBACK_MODEL=meta-models/muse-spark-open

# --- Publishing ---
# 1 publishes finished courses to AERO. 0 (the default) keeps them in the
# database and serves them at /paper-bro/preview/<alias> on LISTEN.
PUBLISH=0
# On the same host as AERO, AERO's local port saves a round trip.
AERO_MCP_URL=https://aero.oops.wtf/mcp
PUBLIC_ORIGIN=https://aero.oops.wtf

# --- Browser QA ---
# chrome-headless-shell from Chrome for Testing, pinned; see README.md.
CHROME_PATH=.chrome/chrome-headless-shell-mac-arm64/chrome-headless-shell

# --- Server ---
LISTEN=127.0.0.1:8083
# Admin routes have no auth, so this must stay on loopback.
ADMIN_LISTEN=127.0.0.1:8085
# Build workers. Default: 2 when PUBLISH=1, none in a dry run, so a local
# server never takes real requests off a shared queue.
# WORKERS=2

# --- Limits ---
BUILDS_PER_IP_PER_DAY=3
BUILDS_PER_DAY=40
MAX_QUEUED=20
DAILY_BUDGET_USD=50
